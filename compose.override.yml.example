# Your own settings for the Docker setup.
#
# Copy this file to compose.override.yml, next to compose.yml:
#
#     cp compose.override.yml.example compose.override.yml
#
# Docker Compose reads compose.override.yml automatically and lays it over compose.yml.
# It is git-ignored, so your changes stay on your machine and an update never overwrites
# them. Uncomment the lines you want and change their values. Settings are read once, at
# start: after a change, stop the app (Ctrl+C, or `docker compose down`) and run
# `docker compose up` again. The README's "Environment variables" section has the detail.
services:
  app:
    environment:
      # ---- Your music, for building a corpus ----
      # Folders the corpus picker may read, as paths inside the container, separated by
      # commas. Each needs a volume below. ./data/corpus is always offered as well.
      # IMPORT_ROOTS: /import

      # ---- The app ----
      # Host names the page may be reached by. Add a LAN name or address to open it
      # from another device; "*" turns the check off.
      # ALLOWED_HOSTS: localhost,127.0.0.1,::1

      # The largest recording you can upload, in MB. Raise ENGINE_MAX_UPLOAD_MB on the
      # engine to the same figure.
      # MAX_UPLOAD_MB: "2048"

      # Torch threads for stem separation (default: half the CPUs).
      # STEMS_THREADS: "8"

      # Demucs segments at once (default: a quarter of the CPUs, up to 4). 1 uses the
      # least memory; 4 is fastest.
      # STEMS_JOBS: "4"

      # The average level, in dB, below which a take is marked "Weak render".
      # WEAK_RENDER_DB: "-24"

      # ---- Training a LoRA ----
      # The fewest steps a run gets. Small corpora need it: ten passes over 14 songs
      # is only 150 steps.
      # TRAIN_MIN_STEPS: "500"

      # Passes over each song, for a corpus big enough to need more than the floor.
      # TRAIN_PASSES: "10"

      # A fixed step count for every run, in place of the two above.
      # TRAIN_STEPS: "600"

      # Steps between the checkpoints a run saves.
      # TRAIN_CHECKPOINT_EVERY: "50"

      # How much of each song is trained on, from its start, in minutes.
      # TRAIN_MAX_MINUTES: "3.5"

      # How much the Planner half (melody and structure) can hold. Higher can capture
      # more, and overfits more easily.
      # TRAIN_RANK_PLANNER: "64"

      # The same for the Sound half.
      # TRAIN_RANK_DECODER: "32"

      # Steps for the Sound half, whatever the corpus size.
      # TRAIN_DECODER_STEPS: "1000"

    volumes:
      # ---- Mounts for IMPORT_ROOTS ----
      # A folder on this machine, then where the app sees it, then ro: read-only. The
      # app never writes to it. The part after the first colon goes in IMPORT_ROOTS.
      #
      # Linux:
      # - /home/you/Music:/import:ro
      #
      # WSL, a Windows drive:
      # - /mnt/d/Music:/import:ro
      #
      # Docker Desktop on Windows:
      # - C:/Users/you/Music:/import:ro
      #
      # More than one: give each its own path inside, and list them all in IMPORT_ROOTS,
      # e.g. IMPORT_ROOTS: /import,/import2
      # - /mnt/e/More music:/import2:ro
